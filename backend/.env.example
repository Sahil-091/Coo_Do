# Copy to backend/.env.local (gitignored) for local dev outside Docker.
# Inside docker-compose these are set directly in docker-compose.yml
# instead — this file documents the pattern for running services
# individually (e.g. `uvicorn app.main:app` from inside a service dir).

# --- migrator only: needs superuser to CREATE ROLE / GRANT ---
# DATABASE_URL=postgresql://postgres:devpassword@localhost/campus_connect

# --- core-api: least-privilege role, no access to safety_events ---
# DATABASE_URL=postgresql+psycopg2://app_core_api:change_me_core_api@localhost/campus_connect

# --- safety-service: least-privilege role, ONLY safety_events ---
# DATABASE_URL=postgresql+psycopg2://app_safety_service:change_me_safety_service@localhost/campus_connect

# Dev-only passwords (match db/grants.sql). Replace via real secrets
# management (not .env files) before any shared/staging/prod environment.
