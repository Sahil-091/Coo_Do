# Copy to backend/.env.local (gitignored) for local dev outside Docker.
# Inside docker-compose these are set directly in docker-compose.yml
# instead — this file documents the pattern for running services
# individually (e.g. `uvicorn app.main:app` from inside a service dir).

# --- migrator only: needs superuser to CREATE ROLE / GRANT ---
DATABASE_URL=postgresql://postgres:A9@localhost/Coo_Do

# --- core-api: least-privilege role, no access to safety_events ---
DATABASE_URL=postgresql+psycopg2://postgres:Askl09109@localhost/Coo_Do
# Required managed secret for private journals. Supply one or more valid
# comma-separated Fernet keys, newest first; do not use a committed or
# development fallback. Rotate by prepending a new key and retaining the old
# key until entries encrypted with it have been re-encrypted or aged out.
JOURNAL_ENCRYPTION_KEYS=YOs_iR6d1sA0apJRzp-voZWzxJJW8QxPcjFtqYUEnuc=
# Required managed secret for trusted-contact identity and destination data.
# Use one or more valid comma-separated Fernet keys, newest first. Keep this
# separate from the journal keyring so it can be rotated independently.
TRUSTED_CONTACT_ENCRYPTION_KEYS=xfEF6DGrwYKCTF6wrtbhE90Yjp4xpoaxQLBY3655oYI=

# --- safety-service: least-privilege role, ONLY safety_events ---
DATABASE_URL=postgresql+psycopg2://app_safety_service:change_me_safety_service@localhost/campus_connect

# Dev-only passwords (match db/grants.sql). Replace via real secrets
# management (not .env files) before any shared/staging/prod environment.

# --- safety-service ---
# Obtain from Google AI Studio. Keep this server-only; never put it in NEXT_PUBLIC_*.
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash
INTERNAL_SHARED_SECRET=ibiclEqIsfaipRTswXkFPXBXW6udDkEBJqzerY
SAFETY_REVIEWER_TOKEN=rP_gZCkT844L_tbN48IrINugI-ms
REVIEWER_DATABASE_URL=REVIEWER_DATABASE_URL=postgresql+psycopg2://app_safety_reviewer:Askl09109@localhost/Coo_DO
SAFETY_RESOURCES_FILE=/absolute/path/to/crisis_resources.india.json
