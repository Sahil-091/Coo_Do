# Copy this file to deploy/.env on each host; do not commit that file.
# Set IMAGE_REPOSITORY to the container registry namespace published by CI.
IMAGE_REPOSITORY=ghcr.io/your-org/campus-connect
IMAGE_TAG=replace-with-immutable-git-sha
# Client-safe values are baked into the image by the release workflow. Set
# matching GitHub Environment variables before publishing the image.
NEXT_PUBLIC_CORE_API_URL=https://api.example.edu
NEXT_PUBLIC_SAFETY_SERVICE_URL=https://safety.example.edu

POSTGRES_USER=campus_connect_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=campus_connect
DATABASE_ADMIN_URL=postgresql://campus_connect_admin:replace-with-a-long-random-password@postgres/campus_connect
APP_CORE_API_DB_PASSWORD=replace-with-a-unique-role-password
APP_SAFETY_SERVICE_DB_PASSWORD=replace-with-a-unique-role-password
APP_SAFETY_REVIEWER_DB_PASSWORD=replace-with-a-unique-role-password
APP_MATCHING_SERVICE_DB_PASSWORD=replace-with-a-unique-role-password
APP_MODERATION_SERVICE_DB_PASSWORD=replace-with-a-unique-role-password
APP_MODERATION_REVIEWER_DB_PASSWORD=replace-with-a-unique-role-password

# Every service must share this value. Generate distinct high-entropy secrets
# for each environment; never reuse local-development defaults.
INTERNAL_SHARED_SECRET=replace-with-a-long-random-shared-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
JOURNAL_ENCRYPTION_KEYS=replace-with-a-fernet-keyring
TRUSTED_CONTACT_ENCRYPTION_KEYS=replace-with-a-different-fernet-keyring
SAFETY_REVIEWER_TOKEN=replace-with-a-long-random-reviewer-token
MODERATION_REVIEWER_TOKEN=replace-with-a-different-long-random-reviewer-token

SAFETY_REVIEWER_EMAILS=reviewer@example.com
MODERATION_REVIEWER_EMAILS=moderator@example.com
PROFESSIONAL_HELP_EDITOR_EMAILS=editor@example.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
